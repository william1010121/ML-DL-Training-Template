#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  scripts/apptainer-run pull <docker://...@sha256:...> <output.sif>
  scripts/apptainer-run exec <cpu|cuda> <image.sif> [mltrain arguments...]
  scripts/apptainer-run exec cuda <image.sif> --launcher torchrun \
    --nproc-per-node <N> --run-id <unique-id> -- [mltrain arguments...]

The pull command refuses mutable tags and writes .oci-digest and .sha256 sidecars.
The exec command verifies both sidecars before starting the workload.
EOF
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

require_apptainer() {
  if ! command -v apptainer >/dev/null 2>&1; then
    echo "error: apptainer is not installed" >&2
    exit 127
  fi
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

command_name=$1
shift

case "$command_name" in
  pull)
    if [[ $# -ne 2 ]]; then
      usage >&2
      exit 2
    fi
    source_image=$1
    sif=$2
    if [[ ! "$source_image" =~ ^docker://.+@sha256:[0-9a-f]{64}$ ]]; then
      echo "error: OCI source must be pinned by a full sha256 digest" >&2
      exit 2
    fi
    if [[ -e "$sif" || -e "$sif.sha256" || -e "$sif.oci-digest" ]]; then
      echo "error: refusing to overwrite $sif or its provenance sidecars" >&2
      exit 2
    fi
    require_apptainer
    apptainer pull --disable-cache "$sif" "$source_image"
    sif_sha256=$(sha256_file "$sif")
    oci_digest=${source_image##*@}
    printf '%s\n' "$oci_digest" >"$sif.oci-digest"
    printf '%s  %s\n' "$sif_sha256" "$(basename "$sif")" >"$sif.sha256"
    echo "created $sif (OCI $oci_digest; SIF sha256:$sif_sha256)"
    ;;

  exec)
    if [[ $# -lt 2 ]]; then
      usage >&2
      exit 2
    fi
    flavor=$1
    sif=$2
    shift 2
    case "$flavor" in
      cpu) ;;
      cuda) ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    launcher=mltrain
    nproc_per_node=
    run_id=
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --launcher)
          [[ $# -ge 2 ]] || { usage >&2; exit 2; }
          launcher=$2
          shift 2
          ;;
        --nproc-per-node)
          [[ $# -ge 2 ]] || { usage >&2; exit 2; }
          nproc_per_node=$2
          shift 2
          ;;
        --run-id)
          [[ $# -ge 2 ]] || { usage >&2; exit 2; }
          run_id=$2
          shift 2
          ;;
        --)
          shift
          break
          ;;
        *) break ;;
      esac
    done
    if [[ "$launcher" != mltrain && "$launcher" != torchrun ]]; then
      echo "error: launcher must be 'mltrain' or 'torchrun'" >&2
      exit 2
    fi
    if [[ "$launcher" == torchrun ]]; then
      if [[ "$flavor" != cuda ]]; then
        echo "error: the template's torchrun helper requires CUDA" >&2
        exit 2
      fi
      if [[ ! "$nproc_per_node" =~ ^[2-9][0-9]*$ ]]; then
        echo "error: --nproc-per-node must be an integer greater than one" >&2
        exit 2
      fi
      if [[ ! "$run_id" =~ ^[A-Za-z0-9_.-]+$ || ${#run_id} -gt 80 || "$run_id" == none || "$run_id" == default ]]; then
        echo "error: --run-id must be a non-default filesystem-safe unique ID (max 80 chars)" >&2
        exit 2
      fi
      if [[ $# -eq 0 ]]; then
        echo "error: torchrun requires an mltrain command after '--'" >&2
        exit 2
      fi
    elif [[ -n "$nproc_per_node" || -n "$run_id" ]]; then
      echo "error: --nproc-per-node and --run-id require --launcher torchrun" >&2
      exit 2
    fi
    require_apptainer
    if [[ ! -f "$sif" || ! -f "$sif.sha256" || ! -f "$sif.oci-digest" ]]; then
      echo "error: SIF, .sha256, and .oci-digest files are all required" >&2
      exit 2
    fi
    expected=$(awk 'NR == 1 {print $1}' "$sif.sha256")
    actual=$(sha256_file "$sif")
    if [[ "$actual" != "$expected" ]]; then
      echo "error: SIF checksum mismatch" >&2
      exit 1
    fi
    oci_digest=$(tr -d '[:space:]' <"$sif.oci-digest")
    if [[ ! "$oci_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
      echo "error: invalid OCI digest sidecar" >&2
      exit 1
    fi

    repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
    mkdir -p \
      "$repo_root/datasets" \
      "$repo_root/checkpoints" \
      "$repo_root/runs" \
      "$repo_root/artifacts"

    if [[ "$launcher" == torchrun ]]; then
      existing_run=$(find "$repo_root/runs" -type d -name "$run_id" -print -quit 2>/dev/null || true)
      if [[ -n "$existing_run" ]]; then
        echo "error: run ID already exists: $run_id" >&2
        exit 2
      fi
    fi

    apptainer_args=(exec --cleanenv)
    if [[ "$flavor" == cuda ]]; then
      apptainer_args+=(--nv)
    fi
    if [[ "$launcher" == torchrun ]]; then
      apptainer_args+=(--env "MLTRAIN_RUN_ID=$run_id")
    fi

    if [[ $# -eq 0 ]]; then
      container_command=(/opt/venv/bin/python -m mltrain --help)
    elif [[ "$launcher" == torchrun ]]; then
      container_command=(
        /opt/venv/bin/torchrun
        --nnodes=1
        --nproc-per-node "$nproc_per_node"
        --rdzv-backend=c10d
        --rdzv-endpoint=localhost:0
        --rdzv-id "$run_id"
        -m mltrain
        "$@"
      )
    else
      container_command=(/opt/venv/bin/python -m mltrain "$@")
    fi

    exec apptainer "${apptainer_args[@]}" \
      --env PYTHONPATH=/workspace/src \
      --env PYTHONDONTWRITEBYTECODE=1 \
      --env MLTRAIN_CONTAINER=apptainer \
      --env "MLTRAIN_OCI_DIGEST=$oci_digest" \
      --env "MLTRAIN_SIF_SHA256=$actual" \
      --bind "$repo_root:/workspace:ro" \
      --bind "$repo_root/datasets:/workspace/datasets:rw" \
      --bind "$repo_root/checkpoints:/workspace/checkpoints:rw" \
      --bind "$repo_root/runs:/workspace/runs:rw" \
      --bind "$repo_root/artifacts:/workspace/artifacts:rw" \
      "$sif" "${container_command[@]}"
    ;;

  *)
    usage >&2
    exit 2
    ;;
esac
